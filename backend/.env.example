# ===== 测管平台 后端环境配置 =====
# 复制此文件为 .env 并修改对应的值

# 数据库连接串
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://your_user:your_password@localhost:3306/your_database?charset=utf8mb4

# JWT 密钥(请替换为一段长随机字符串)
# 可用命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# JWT 算法与有效期(一般不需要修改)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允许的前端跨域地址(开发用 5173,生产可改成实际域名)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Nacos 配置中心(可选) =====
# 如果配置了 Nacos，以上配置项会从 Nacos 加载，实现配置集中管理
# Nacos 服务器地址(多个用逗号分隔)
NACOS_SERVER=

# Nacos 命名空间 ID(留空使用 public)
NACOS_NAMESPACE=

# Nacos 配置 Data ID
NACOS_DATA_ID=testmanage

# Nacos 配置 Group
NACOS_GROUP=DEFAULT_GROUP

# Nacos 用户名(如果开启了鉴权)
NACOS_USERNAME=

# Nacos 密码
NACOS_PASSWORD=
