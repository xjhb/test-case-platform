# ===== 测管平台 后端环境配置 =====
# 复制此文件为 .env 并修改对应的值,本文件只保留占位符,严禁填写真实凭据

# 数据库连接串(<your-server> 替换为实际数据库主机)
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://your_user:your_password@<your-server>:3306/your_database?charset=utf8mb4

# JWT 密钥(请替换为一段长随机字符串)
# 可用命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# JWT 算法与有效期(一般不需要修改)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允许的前端跨域地址,多个用逗号分隔;本机开发填前端实际访问地址,生产填对外域名
CORS_ORIGINS=http://<your-frontend-host>:5173

# ===== Nacos 配置中心(可选) =====
# 如果配置了 Nacos，以上配置项会从 Nacos 加载，实现配置集中管理
# Nacos 服务器地址(多个用逗号分隔)
NACOS_SERVER=

# Nacos 命名空间 ID(留空使用 public)
NACOS_NAMESPACE=

# Nacos 配置 Data ID
NACOS_DATA_ID=testmanage

# Nacos 配置 Group
NACOS_GROUP=DEFAULT_GROUP

# Nacos 用户名(如果开启了鉴权)
NACOS_USERNAME=

# Nacos 密码
NACOS_PASSWORD=

# ===== 外部集成凭据(全部可选) =====
# 留空即视为该通道未接通:集成页面显示"未配置",调用对应接口返回 503 并列出缺失的变量名。
# 以下键同样可以在 Nacos 的 testmanage 配置里以 JSON 提供,由 Nacos 的值覆盖本地。

# --- 邮件通知(SMTP) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 465 端口用 SSL 置 1;587 端口用 STARTTLS 置 0
SMTP_SSL=1

# --- 机器人通知(无需收件人,消息推送到群) ---
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# --- 通知里"查看详情"链接的平台外访地址,留空则不带链接 ---
PLATFORM_BASE_URL=

# --- 外部投递总开关 ---
# 置 0 后站内信照常写入,但不再调用邮件/群机器人;排查或离线环境可关闭
NOTIFY_EXTERNAL_ENABLED=1

# --- Jenkins ---
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_TOKEN=

# --- GitLab CI ---
GITLAB_BASE_URL=
GITLAB_TOKEN=

# --- GitHub Actions(仅填 Token) ---
GITHUB_TOKEN=

# --- Jira ---
JIRA_BASE_URL=
JIRA_USER=
JIRA_TOKEN=
JIRA_PROJECT_KEY=

# --- 禅道 ---
ZENTAO_BASE_URL=
ZENTAO_ACCOUNT=
ZENTAO_PASSWORD=
ZENTAO_PRODUCT_ID=

# --- 外部系统回调鉴权 ---
# 配置后,Jira/禅道/CI 可用请求头 X-Webhook-Token(或 ?token=)直接回调 /api/integrations/webhook;
# 留空则回调必须携带平台登录令牌。
WEBHOOK_SECRET=
