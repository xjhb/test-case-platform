# ===== 测管平台 后端环境配置 =====
# 复制此文件为 .env 并修改对应的值

# 数据库连接串
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://your_user:your_password@localhost:3306/your_database?charset=utf8mb4

# JWT 密钥(请替换为一段长随机字符串)
# 可用命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# JWT 算法与有效期(一般不需要修改)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允许的前端跨域地址(开发用 5173,生产可改成实际域名)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
